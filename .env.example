# Copy to .env and fill in. .env is git-ignored.

# --- Supabase (Project Settings -> API) ---
SUPABASE_PROJECT_REF=            # e.g. abcdefghijklmnop (from https://<ref>.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=       # service_role key (NOT anon) - used for cron and manual calls
SUPABASE_ACCESS_TOKEN=           # https://supabase.com/dashboard/account/tokens - for the CLI

# --- Edge Function secrets (pushed by deploy.ps1 via `supabase secrets set`) ---
# LLM: GEMINI_API_KEY wins if set (free Flash Lite). Else Anthropic, else Vercel AI Gateway.
GEMINI_API_KEY=                  # Google AI Studio key (AQ....)
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=               # https://console.anthropic.com
AI_GATEWAY_API_KEY=              # Vercel AI Gateway (vck_...); needs a card on file
CLAUDE_MODEL=gemini-flash-lite-latest
# CLAUDE_API_URL=                # override the Anthropic Messages endpoint if needed
WEBHOOK_SECRET=                  # long random string; WAHA appends it as ?secret=
WAHA_URL=                        # public https URL of WAHA (needed for bot replies / POST_TO_GROUP)
WAHA_API_KEY=                    # same value as WHATSAPP_API_KEY in docker-compose
WAHA_SESSION=default
BOT_PHONE=                       # bot's own number, digits only, e.g. 996555123456
BOT_LID=                         # bot LID jid, e.g. 190160415277256@lid
BOT_CODE_WORD=сводка             # extra trigger word (in addition to /summary and @mention)
BOT_MENTION_NAMES=Zuhra          # comma-separated display names that count as @mention
POST_TO_GROUP=false              # post the daily summary back into the group
MIN_MESSAGES=2                   # skip chats with fewer messages in the window
LOG_RAW_EVENTS=true              # write raw WAHA payloads to wa_raw_events (turn off after inspection)

# --- Frontend (web/.env, Vite) ---
VITE_SUPABASE_URL=               # https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=          # anon key

# --- Local Docker ---
WAHA_PORT=3000                   # host port for WAHA (3000 was busy on the dev machine -> 3001)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=       # WAHA rejects weak defaults and generates its own unless set
